# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY="your-production-secret-key-here"

# Set to False in production
DEBUG=False

# Database URL connection string pointing to Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:6543/postgres?pgbouncer=true"

# Hostnames allowed to access the site
ALLOWED_HOSTS="your-deployment-url.onrender.com,localhost,127.0.0.1"

# Supabase Storage S3 credentials (for profile images & reports persistence)
SUPABASE_ACCESS_KEY_ID=""
SUPABASE_SECRET_ACCESS_KEY=""
SUPABASE_BUCKET_NAME=""
SUPABASE_S3_ENDPOINT=""
